{
  "name": "@meterbility/proxy",
  "version": "0.6.4",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@meterbility/shared": "^0.6.4",
    "@meterbility/spec": "^0.6.4",
    "@meterbility/collector": "^0.6.4",
    "hono": "^4.6.0",
    "@hono/node-server": "^1.13.0"
  },
  "description": "Anthropic/OpenAI capture proxy for Meterbility",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoneycombHairDevelopers/Meterbility.git",
    "directory": "packages/proxy"
  },
  "homepage": "https://github.com/HoneycombHairDevelopers/Meterbility#readme",
  "bugs": {
    "url": "https://github.com/HoneycombHairDevelopers/Meterbility/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "types": "dist/index.d.ts",
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "esm"
    ],
    "dts": true,
    "clean": true
  },
  "scripts": {
    "build": "tsup"
  }
}
